# Copy to .env only for local development. Never commit real values.
BURNUI_DATABASE_URL=sqlite:///C:/Users/Deepak Roy/OneDrive/Desktop/PROJECT/backend/data/burnui.sqlite3
# Generate with a cryptographically secure password manager; use at least 32 random characters.
BURNUI_SESSION_SECRET=replace-with-a-long-random-secret
# Set true for HTTPS deployments. Local HTTP development may use false.
BURNUI_COOKIE_SECURE=false
# The frontend URL used to build one-time activation links.
BURNUI_PUBLIC_BASE_URL=http://localhost:5173

# Gmail SMTP uses STARTTLS on port 587. Use a Google App Password here, never
# a normal Google account password. Replace every placeholder in a real .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@example.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your-gmail-address@example.com

BURNUI_ADMIN_CONTACT_EMAIL=burnui-admin@example.com
BURNUI_ADMIN_EMAIL=burnui-admin@example.com
BURNUI_ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
